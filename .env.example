# Dupliquer ce fichier sous le nom .env et remplacer les valeurs.
# Ne jamais envoyer le véritable fichier .env sur Git.
DJANGO_SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine.fr
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=utilisateur-smtp
EMAIL_HOST_PASSWORD=mot-de-passe-smtp
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tacos Express <noreply@example.com>
